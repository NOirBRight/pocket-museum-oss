+	g_keepSavedata = keep ? 1 : 0;
+}
+
 bool retro_unserialize(const void* data, size_t size) {
 	if (deferredSetup) {
 		_doDeferredSetup();
 	}
 	struct VFile* vfm = VFileFromConstMemory(data, size);

+size_t blip_state_size(const blip_t* m)
+{
+	return sizeof *m + (m->size + buf_extra) * sizeof(buf_t);
+}
+
+int blip_save_state(const blip_t* m, void* out, size_t size)
+{
+	if (!out || size != blip_state_size(m)) return 0;
+	memcpy(out, m, size);
+	return 1;
+}
+
+int blip_load_state(blip_t* m, const void* data, size_t size)
+{
+	if (!data || size != blip_state_size(m) || ((const blip_t*) data)->size != m->size) return 0;
+	memcpy(m, data, size);
+	return 1;
